// Requires a {{brief}} variable describing what to build, e.g.:
//   smasher run examples/product_design_factory.dot --var brief="A dashboard for tracking home energy usage, aimed at non-technical homeowners"
// or, from the web dashboard, the "Product Brief" field on the submit form.
digraph ProductDesignFactory {
  graph [
    goal="Discover a product design direction, define it against real usability and design-system critique, and deliver a pruned, accessible build.",
    rankdir=LR,
    default_max_retry=2
  ];

  Start [shape=Mdiamond, label="Start"];
  Exit  [shape=Msquare, label="Exit"];

  // --- Intake: clarify the raw brief with the user before any design work ---

  // Codergen (box) node output isn't propagated into the pipeline context —
  // only a hexagon gate's own human answer is (stored under the gate's node
  // id). ComposeBrief needs the questions on disk (Codergen-to-Codergen still
  // only shares state via the filesystem), but the dashboard's question card
  // needs them too, and that's a separate channel: question_source below
  // tells InterviewerHandler to pull ClarifyQuestions' final reply straight
  // out of the engine's ArtifactStore (every node's Outcome is recorded
  // there regardless of context propagation) and show it on the card instead
  // of just this node's static label.
  ClarifyQuestions [
    shape=box,
    label="Analyse brief, draft clarifying questions",
    prompt="Product brief: {{brief}}\n\nAnalyse this brief for ambiguity, missing constraints, or unstated assumptions that would materially change the design direction (target users, platform, must-have features, tone/brand, technical constraints, existing design system to match, etc.) and to identify the goal. Write at most 5 numbered clarifying questions to ./intake/questions.md (create the directory if needed), and reply with that exact numbered list as your final message so it can be shown to the user directly. If the brief is already clear and unambiguous, write a single line to that file saying no clarification is needed, and give that same line as your final reply."
  ];

  ClarifyGate [
    shape=hexagon,
    label="Answer the clarifying questions below (or type 'skip' if the brief is already clear):",
    mode="freeform",
    question_source="ClarifyQuestions"
  ];

  ComposeBrief [
    shape=box,
    label="Combine answers into a refined brief",
    prompt="Original product brief: {{brief}}\n\nRead ./intake/questions.md, and combine the original brief with the user's answers (given above in the pipeline context) into a single, self-contained, unambiguous product brief. Write the result to ./intake/brief.md. This refined brief is what all subsequent design work must follow."
  ];

  // --- Discover: wide exploration, cheap kit-based candidates ---

  IAOptions [
    shape=box,
    label="Build interaction approaches from kit",
    prompt="Refined product brief: read ./intake/brief.md (original brief plus clarifying Q&A: {{brief}}).\n\nBuild 3-4 distinct, working interaction patterns (not visual skins) under ./candidates/discover-a/, ./candidates/discover-b/, ./candidates/discover-c/, and ./candidates/discover-d/ (build up to 4 if the brief supports that many distinct directions; fewer is fine, but each one built must use its listed directory exactly)."
  ];

  // Real render_capture is one-candidate-per-call, so Discover's 4 candidates
  // are 4 sequential Tool nodes into one gate — the same proven topology as
  // examples/gallery_gate_showcase.dot (no fan-in-into-gate has been tested).
  RenderDiscoverA [
    shape=parallelogram,
    label="Render candidate A",
    tool="render_capture",
    args="{\"candidate_dir\": \"./candidates/discover-a\", \"candidate_id\": \"discover-a\"}"
  ];
  RenderDiscoverB [
    shape=parallelogram,
    label="Render candidate B",
    tool="render_capture",
    args="{\"candidate_dir\": \"./candidates/discover-b\", \"candidate_id\": \"discover-b\"}"
  ];
  RenderDiscoverC [
    shape=parallelogram,
    label="Render candidate C",
    tool="render_capture",
    args="{\"candidate_dir\": \"./candidates/discover-c\", \"candidate_id\": \"discover-c\"}"
  ];
  RenderDiscoverD [
    shape=parallelogram,
    label="Render candidate D",
    tool="render_capture",
    args="{\"candidate_dir\": \"./candidates/discover-d\", \"candidate_id\": \"discover-d\"}"
  ];

  GalleryGate1 [
    shape=hexagon,
    gallery="true",
    label="Human: pick direction(s)",
    candidate_count="phase_default(discover)"
  ];

  // --- Define: build out the chosen direction, critique it two ways ---

  Implement [
    shape=box,
    label="Implement chosen direction",
    prompt="Refined product brief: read ./intake/brief.md (original brief plus clarifying Q&A: {{brief}}).\n\nBuild out the selected pattern under ./build/define/."
  ];

  RenderDefine [
    shape=parallelogram,
    label="Render + capture build",
    tool="render_capture",
    args="{\"candidate_dir\": \"./build/define\", \"candidate_id\": \"define\"}"
  ];

  CritiqueParallel [shape=component, label="Critique (Parallel)"];

  SystemLint [
    shape=parallelogram,
    label="Design-system check",
    tool="system_lint",
    args="{\"candidate_dir\": \"./build/define\", \"candidate_id\": \"define\"}"
  ];

  TaskCritic [
    shape=parallelogram,
    label="Usability critic",
    tool="task_critic",
    args="{\"candidate_id\": \"define\", \"persona\": \"a new user unfamiliar with the product\", \"task\": \"find the primary call-to-action button\"}"
  ];

  CritiqueJoin [shape=tripleoctagon, label="Critique Join"];

  Synthesis [
    shape=parallelogram,
    label="Synthesise critiques",
    tool="synthesis",
    args="{\"candidate_id\": \"define\"}"
  ];

  GalleryGate2 [
    shape=hexagon,
    gallery="true",
    label="Human: reaction, next step",
    candidate_count="phase_default(define)"
  ];

  // --- Deliver: prune, check accessibility ---

  Prune [
    shape=box,
    label="Cut non-value elements",
    prompt="Remove anything not serving the refined product brief (./intake/brief.md, or the original brief {{brief}} if that file is absent) from ./build/define/. Prefer kit/native components over custom ones."
  ];

  // No real axe-core integration exists yet (deliberately deferred — see
  // design-factory/tasks/todo.md Task 10). This is a placeholder shell command
  // standing in for a future native `a11y_check` tool, not a real audit.
  A11yCheck [
    shape=parallelogram,
    label="Accessibility check (stub — axe-core wiring deferred)",
    tool_command="echo 'axe-core stub: no violations (placeholder, not a real audit)'"
  ];

  Start -> ClarifyQuestions -> ClarifyGate -> ComposeBrief -> IAOptions;
  IAOptions -> RenderDiscoverA -> RenderDiscoverB -> RenderDiscoverC -> RenderDiscoverD -> GalleryGate1;

  GalleryGate1 -> Implement [label="proceed"];

  Implement -> RenderDefine;
  RenderDefine -> CritiqueParallel [label="ok", condition="outcome=success"];
  // Render can fail after exhausting its own retries (e.g. a headless-Chromium
  // crash). Without this edge the engine falls back to the unconditional path
  // into CritiqueParallel anyway, and TaskCritic/Synthesis then fail on a
  // missing screenshot/critic-report instead of the real problem being visible.
  RenderDefine -> Exit [label="failure", condition="outcome=fail"];
  CritiqueParallel -> SystemLint -> CritiqueJoin;
  CritiqueParallel -> TaskCritic -> CritiqueJoin;
  CritiqueJoin -> Synthesis -> GalleryGate2;

  GalleryGate2 -> Implement [label="iterate"];
  GalleryGate2 -> Prune     [label="proceed"];

  Prune -> A11yCheck -> Exit;
}
