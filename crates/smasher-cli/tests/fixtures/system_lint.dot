digraph SystemLintE2E {
  graph [
    goal="Prove that a system_lint Tool node dispatches natively through smasher run, making zero LLM calls."
  ];

  Start [shape=Mdiamond, label="Start"];
  Lint1 [
    shape=parallelogram,
    label="System Lint",
    tool="system_lint",
    args="{\"candidate_dir\": \"crates/smasher-system-lint/fixtures/clean-candidate\", \"run_id\": \"e2e-system-lint-fixture\", \"candidate_id\": \"fixture\"}"
  ];
  Exit [shape=Msquare, label="Exit"];

  Start -> Lint1;
  Lint1 -> Exit;
}
