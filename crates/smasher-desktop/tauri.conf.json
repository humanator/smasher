{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smasher",
  "version": "0.1.0",
  "identifier": "com.smasher.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "npm run dev -- --strictPort",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
